{
  "name": "@mcpolyglot/connector-priority",
  "version": "0.0.0",
  "private": true,
  "description": "Priority ERP connector for mcpolyglot (scaffold). Read tools over the Priority REST (OData) API, writes only for allow-listed entities, upstream limits respected.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishay60/mcpolyglot.git",
    "directory": "packages/connector-priority"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mcpolyglot/core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  }
}
