{
  "name": "@mcpolyglot/testkit",
  "version": "0.0.1",
  "description": "MCP conformance harness and test fixtures for mcpolyglot connectors. Drives stdio servers like a real MCP client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishay60/mcpolyglot.git",
    "directory": "packages/testkit"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
