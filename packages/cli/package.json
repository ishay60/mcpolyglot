{
  "name": "@mcpolyglot/cli",
  "version": "0.1.0",
  "description": "mcpolyglot command-line interface. Initializes config, serves the MCP server (stdio or HTTP), and validates connectivity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishay60/mcpolyglot.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "mcpolyglot": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@mcpolyglot/config": "workspace:^",
    "@mcpolyglot/connector-mongo": "workspace:^",
    "@mcpolyglot/connector-sql": "workspace:^",
    "@mcpolyglot/core": "workspace:^",
    "@mcpolyglot/security": "workspace:^",
    "commander": "^14.0.3",
    "picocolors": "^1.1.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
