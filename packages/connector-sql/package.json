{
  "name": "@mcpolyglot/connector-sql",
  "version": "0.4.0",
  "description": "Shared SQL connector for mcpolyglot with Postgres, MySQL/MariaDB, and SQLite dialects. Read-only-by-default with per-dialect enforcement.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishay60/mcpolyglot.git",
    "directory": "packages/connector-sql"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mcpolyglot/core": "workspace:^",
    "node-sql-parser": "^5.3.4",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
