{
  "name": "@mcpolyglot/connector-openapi",
  "version": "0.0.0",
  "description": "OpenAPI connector for mcpolyglot. Calls only operations in the spec, with a method allow-list and the host pinned to the configured base URL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishay60/mcpolyglot.git",
    "directory": "packages/connector-openapi"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mcpolyglot/core": "workspace:^",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
